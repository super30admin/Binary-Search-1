// Similar to the previous approach, but this time iterating over the rows. And then doing binary search only if we find if target is present in the row. Handling //boundary case of nums = [[1]] and target = 1
class Solution:
    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:

        def search(nums: List[int], target: int) -> int: # Binary search O(log n)
            if len(nums)==1:
                return nums[0] == target

            low = 0
            high = len(nums) - 1
            while low <= high:
                    mid = low + (high - low)//2
                    if target == nums[mid]:
                        return True
                    
                    elif target < nums[mid]: # Check left
                        high = mid - 1

                    else: # Check right
                        low = mid + 1
                    
            return False

        for row in matrix:  #O(m)
            if (target <= row[-1]):
                if search(row,target):
                    return True
        return False



